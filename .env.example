# FMP API Key (무료 플랜 250 req/day)
FMP_API_KEY=your_fmp_api_key_here

# Z.AI API Key (GLM-5, GLM-5-Turbo 사용)
ZAI_API_KEY=your_zai_api_key_here

# Database (Render PostgreSQL 설정)
DATABASE_URL=postgresql://user:password@your-render-db-url:5432/ai_signal_talk

# JWT Secret Key (배포 시 변경 필수)
SECRET_KEY=your-secret-key-here-change-in-production

# Optional: Fallback API Keys (필요시 설정)
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Server Settings
HOST=0.0.0.0
PORT=8000
